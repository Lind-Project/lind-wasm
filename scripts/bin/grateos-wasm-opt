#!/usr/bin/env bash
set -Eeuo pipefail

# grateos-wasm-opt — wasm-opt wrapper that applies grateos's standard instrumentation
# flags for a given compilation target.
#
# Usage:
#   grateos-wasm-opt (--target=<target> | --static) [OPTIONS] input.wasm -o output.wasm
#
# Exactly one of --target or --static must be given:
#   --target=main      Dynamic main-module binary.
#   --target=library   Dynamic shared-library binary.
#   --target=libc      libc shared library (already owns signal_callback; omits epoch-main-module).
#   --static           Static (non-dynamic) binary.
#
# Options:
#   --fpcast-emu          Enable function-pointer-cast emulation.
#   --without-asyncify    Omit asyncify instrumentation.
#   --without-epoch       Omit epoch/signal instrumentation.
#   -v, --verbose         Print the exact wasm-opt command before executing it.
#   -h, --help            Show this help and exit.
#
# Examples:
#   grateos-wasm-opt --target=main    input.wasm -o output.wasm
#   grateos-wasm-opt --target=library input.wasm -o output.wasm
#   grateos-wasm-opt --target=libc    libc.so -o libc.so
#   grateos-wasm-opt --static         input.wasm -o output.wasm
#   grateos-wasm-opt --target=main --fpcast-emu input.wasm -o output.wasm
#   grateos-wasm-opt --static --fpcast-emu      input.wasm -o output.wasm
#   grateos-wasm-opt --target=main --without-asyncify --without-epoch input.wasm -o output.wasm

usage() {
  sed -n '/^# Usage:/,/^[^#]/{ /^[^#]/d; s/^# \{0,3\}//; p }' "$0" >&2
}

TARGET=""
STATIC="false"
WITH_FPCAST="false"
WITHOUT_ASYNCIFY="false"
WITHOUT_EPOCH="false"
PRINT_CMD="false"

# --- option parsing ---
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --target=main|--target=library|--target=libc)
      TARGET="${1#--target=}"
      ;;
    --target=*)
      echo "error: unknown target '${1#--target=}' (expected: main, library, libc)" >&2
      usage
      exit 2
      ;;
    --static)
      STATIC="true"
      ;;
    --fpcast-emu)
      WITH_FPCAST="true"
      ;;
    --without-asyncify)
      WITHOUT_ASYNCIFY="true"
      ;;
    --without-epoch)
      WITHOUT_EPOCH="true"
      ;;
    -v|--verbose)
      PRINT_CMD="true"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
  shift
done

if [[ "${STATIC}" == "true" && -n "${TARGET}" ]]; then
  echo "error: --static and --target are mutually exclusive" >&2
  usage
  exit 2
fi

if [[ "${STATIC}" == "false" && -z "${TARGET}" ]]; then
  echo "error: one of --target=main, --target=library, --target=libc, or --static is required" >&2
  usage
  exit 2
fi

# Expect exactly: input.wasm -o output.wasm
if [[ "$#" -ne 3 || "$2" != "-o" ]]; then
  echo "error: expected exactly: input.wasm -o output.wasm" >&2
  usage
  exit 2
fi

INPUT_WASM="$1"
OUTPUT_WASM="$3"

if [[ ! -f "${INPUT_WASM}" ]]; then
  echo "error: input file not found: ${INPUT_WASM}" >&2
  exit 2
fi

# --- locate wasm-opt (repo-relative, matching grateos_compile's path) ---
if [[ -n "${GRATEOS_WASM_ROOT:-}" && -d "${GRATEOS_WASM_ROOT}" ]]; then
  REPO_ROOT="${GRATEOS_WASM_ROOT}"
else
  SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "${SCRIPT_DIR}/../../Makefile" ]]; then
    REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
  elif command -v git >/dev/null 2>&1; then
    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  else
    REPO_ROOT=""
  fi
fi

if [[ -z "${REPO_ROOT}" || ! -d "${REPO_ROOT}" ]]; then
  echo "error: cannot locate grateos-wasm repo root; export GRATEOS_WASM_ROOT=/path/to/grateos-wasm" >&2
  exit 2
fi

WASM_OPT_BIN="${REPO_ROOT}/tools/binaryen/bin/wasm-opt"
if [[ ! -x "${WASM_OPT_BIN}" ]]; then
  echo "error: wasm-opt not found at ${WASM_OPT_BIN}" >&2
  exit 127
fi

# --- build flag list, matching grateos_compile's do_optimize() exactly ---
GRATEOS_FLAGS=()

if [[ "${STATIC}" == "true" ]]; then
  if [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]]; then
    GRATEOS_FLAGS+=(--enable-exception-handling --enable-reference-types)
  fi
  [[ "${WITHOUT_EPOCH}" == "false" ]] && GRATEOS_FLAGS+=(--epoch-injection)
  [[ "${WITHOUT_ASYNCIFY}" == "false" ]] && GRATEOS_FLAGS+=(--asyncify)
  if [[ "${WITH_FPCAST}" == "true" ]]; then
    GRATEOS_FLAGS+=(--fpcast-emu)
  fi
  # Convert clang 18 legacy EH (try/catch/throw) to standard EH (try_table/throw) after
  # asyncify: asyncify handles legacy EH natively but Cranelift only supports standard EH.
  # --enable-reference-types is required because --translate-to-exnref emits (ref exn) blocks
  # (via catch_all_ref) when setjmp frames are nested across function calls.
  [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]] && GRATEOS_FLAGS+=(--translate-to-exnref)
elif [[ "${TARGET}" == "main" ]]; then
  if [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]]; then
    GRATEOS_FLAGS+=(--enable-bulk-memory --enable-threads --enable-exception-handling --enable-reference-types)
  else
    GRATEOS_FLAGS+=(--enable-bulk-memory --enable-threads)
  fi
  if [[ "${WITHOUT_EPOCH}" == "false" ]]; then
    GRATEOS_FLAGS+=(--epoch-injection --pass-arg=epoch-import --pass-arg=epoch-main-module)
  fi
  if [[ "${WITHOUT_ASYNCIFY}" == "false" ]]; then
    GRATEOS_FLAGS+=(--asyncify --pass-arg=asyncify-import-globals)
  fi
  if [[ "${WITH_FPCAST}" == "true" ]]; then
    GRATEOS_FLAGS+=(--fpcast-emu --pass-arg=relocatable-fpcast)
  fi
  # Convert clang 18 legacy EH (try/catch/throw) to standard EH (try_table/throw) after
  # asyncify: asyncify handles legacy EH natively but Cranelift only supports standard EH.
  # --enable-reference-types is required because --translate-to-exnref emits (ref exn) blocks
  # (via catch_all_ref) when setjmp frames are nested across function calls.
  [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]] && GRATEOS_FLAGS+=(--translate-to-exnref)
elif [[ "${TARGET}" == "library" ]]; then
  if [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]]; then
    GRATEOS_FLAGS+=(--enable-bulk-memory --enable-threads --enable-exception-handling --enable-reference-types)
  else
    GRATEOS_FLAGS+=(--enable-bulk-memory --enable-threads)
  fi
  if [[ "${WITHOUT_EPOCH}" == "false" ]]; then
    GRATEOS_FLAGS+=(--epoch-injection --pass-arg=epoch-import --pass-arg=epoch-main-module)
  fi
  if [[ "${WITHOUT_ASYNCIFY}" == "false" ]]; then
    GRATEOS_FLAGS+=(--asyncify --pass-arg=asyncify-import-globals)
  fi
  if [[ "${WITH_FPCAST}" == "true" ]]; then
    GRATEOS_FLAGS+=(--fpcast-emu --pass-arg=relocatable-fpcast)
  fi
  [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]] && GRATEOS_FLAGS+=(--translate-to-exnref)
else  # libc — owns signal_callback; inject epoch calls without redefining/reimporting it
  if [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]]; then
    GRATEOS_FLAGS+=(--enable-bulk-memory --enable-threads --enable-exception-handling --enable-reference-types)
  else
    GRATEOS_FLAGS+=(--enable-bulk-memory --enable-threads)
  fi
  if [[ "${WITHOUT_EPOCH}" == "false" ]]; then
    GRATEOS_FLAGS+=(--epoch-injection --pass-arg=epoch-import)
  fi
  if [[ "${WITHOUT_ASYNCIFY}" == "false" ]]; then
    GRATEOS_FLAGS+=(--asyncify --pass-arg=asyncify-import-globals)
  fi
  if [[ "${WITH_FPCAST}" == "true" ]]; then
    GRATEOS_FLAGS+=(--fpcast-emu --pass-arg=relocatable-fpcast)
  fi
  [[ -z "${GRATEOS_ASYNCIFY_SETJMP:-}" ]] && GRATEOS_FLAGS+=(--translate-to-exnref)
fi

GRATEOS_FLAGS+=(-O2 --debuginfo)

# --- run wasm-opt ---
if [[ "${PRINT_CMD}" == "true" ]]; then
  printf '+ %q' "${WASM_OPT_BIN}" >&2
  printf ' %q' "${GRATEOS_FLAGS[@]}" "${INPUT_WASM}" -o "${OUTPUT_WASM}" >&2
  printf '\n' >&2
fi

exec "${WASM_OPT_BIN}" "${GRATEOS_FLAGS[@]}" "${INPUT_WASM}" -o "${OUTPUT_WASM}"
