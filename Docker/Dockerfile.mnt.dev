# syntax=docker/dockerfile:1.7-labs
# NOTE: Enable Docker Labs syntax for future convenience

# Base image for development and debugging with perf and gdb support
#
# - Installs standard build tools and debugging utilities
# - Assumes container is run with --privileged for perf to function
# - Assumes lind-wasm directory is mounted from host filesystem
#
# Usage:
#     docker build --platform=linux/amd64 --build-arg USERNAME=lind -f Docker/Dockerfile.mnt.dev -t lind-mnt-dev .
#     docker run --platform=linux/amd64 -it --privileged --ipc=host --init --cap-add=SYS_PTRACE \
#                -v $(pwd):/home/lind/lind-wasm lind-mnt-dev /bin/bash

FROM ubuntu:22.04

# --- Build arguments ---
ARG USERNAME=lind
ARG LLVM_VERSION="llvmorg-18.1.8"
ARG CLANG_PACKAGE="clang+llvm-18.1.8-x86_64-linux-gnu-ubuntu-18.04"
ARG WABT_VERSION="1.0.38"

# --- System setup ---
ENV DEBIAN_FRONTEND=noninteractive

# Install base tools
RUN apt-get update && apt-get install -y --no-install-recommends -qq \
    binutils \
    bison \
    cmake \
    flex \
    build-essential \
    ca-certificates \
    strace \
    curl \
    gawk \
    git \
    gnupg \
    libc6-dev-i386-cross \
    libxml2 \
    make \
    python3 \
    sed \
    sudo \
    unzip \
    zip \
    autoconf \
    rsync \
    libtool \
    automake \
    vim \
    wget \
    openssl \
    libssl-dev \
    golang \
    gdb \
    linux-tools-common \
    linux-tools-generic \
    tzdata \
    python3.10-venv \
    && rm -rf /var/lib/apt/lists/*

# Install a pinned WABT version for wasm2wat/wat2wasm/wasm-objdump.
RUN curl -fsSL "https://github.com/WebAssembly/wabt/releases/download/${WABT_VERSION}/wabt-${WABT_VERSION}.tar.xz" -o /tmp/wabt.tar.xz && \
    mkdir -p /tmp/wabt-src && \
    tar -xJf /tmp/wabt.tar.xz -C /tmp/wabt-src --strip-components=1 && \
    cmake -S /tmp/wabt-src -B /tmp/wabt-src/build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF && \
    cmake --build /tmp/wabt-src/build --target wasm2wat wat2wasm wasm-objdump --parallel "$(nproc)" && \
    install -m 0755 /tmp/wabt-src/build/wasm2wat /usr/local/bin/wasm2wat && \
    install -m 0755 /tmp/wabt-src/build/wat2wasm /usr/local/bin/wat2wasm && \
    install -m 0755 /tmp/wabt-src/build/wasm-objdump /usr/local/bin/wasm-objdump && \
    rm -rf /tmp/wabt.tar.xz /tmp/wabt-src

# --- Create user ---
RUN groupadd --gid 1000 ${USERNAME} && \
    useradd --uid 1000 --gid ${USERNAME} --create-home --shell /bin/bash ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Install libtinfo5 as root ---
RUN wget http://security.ubuntu.com/ubuntu/pool/universe/n/ncurses/libtinfo5_6.3-2ubuntu0.1_amd64.deb && \
    apt install ./libtinfo5_6.3-2ubuntu0.1_amd64.deb

# --- Switch to user ASAP ---
USER ${USERNAME}
WORKDIR /home/${USERNAME}

# --- Install Rust as user ---
# --profile minimal tells rustup to install only the essentials for the toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal
RUN /home/${USERNAME}/.cargo/bin/rustup component add rust-src --toolchain nightly-2026-02-11-x86_64-unknown-linux-gnu

# --- Create lind-wasm directory (will be mounted from host) ---
RUN mkdir -p /home/${USERNAME}/lind-wasm

# --- Switch back to root for installing Clang binaries ---
USER root

# Install Clang to /opt instead of lind-wasm directory (which will be mounted)
RUN mkdir -p /opt/clang && \
    curl -sL https://github.com/llvm/llvm-project/releases/download/${LLVM_VERSION}/${CLANG_PACKAGE}.tar.xz | \
    tar -xJ -C /opt/clang --strip-components=1 && \
    ln -sf /opt/clang/bin/* /usr/local/bin/

# --- Back to user for everything else ---
USER ${USERNAME}

# --- Fix PATH ---
ENV PATH="/usr/local/bin:/home/${USERNAME}/.cargo/bin:/home/${USERNAME}/go/bin:$PATH"
ENV CLANG="/opt/clang"
ENV MATH_TEST_DIR="math_tests"
ENV LIND_WASM_ROOT=/home/${USERNAME}/lind-wasm

# --- Create entrypoint script to set up glibc wasi includes at runtime ---
USER root
RUN echo '#!/bin/bash\n\
set -e\n\
if [ -d "/home/lind/lind-wasm/src/glibc/wasi" ] && [ ! -d "/opt/clang/lib/clang/18/lib/wasi" ]; then\n\
  echo "Copying glibc wasi includes..."\n\
  cp -r /home/lind/lind-wasm/src/glibc/wasi /opt/clang/lib/clang/18/lib/\n\
  chown -R lind:lind /home/lind/lind-wasm\n\
fi\n\
cd /home/lind/lind-wasm\n\
exec runuser -u lind -- "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh

# --- Make lind_* scripts available from /usr/local/bin ---
# These will be symlinks to the mounted directory
RUN ln -sf /home/${USERNAME}/lind-wasm/scripts/lind_compile /usr/local/bin/lind_compile \
 && ln -sf /home/${USERNAME}/lind-wasm/scripts/lind_run     /usr/local/bin/lind_run     \
 && ln -sf /home/${USERNAME}/lind-wasm/scripts/cargo-lind_compile /usr/local/bin/cargo-lind_compile \
 && ln -sf /usr/local/bin/lind_compile /usr/local/bin/lind-clang \
 && ln -sf /usr/local/bin/lind_run     /usr/local/bin/lind-wasm \
 && ln -sf /usr/local/bin/cargo-lind_compile /usr/local/bin/lind-cargo-build

# Note: Entrypoint runs as root, then switches to lind user
WORKDIR /home/${USERNAME}/lind-wasm
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
